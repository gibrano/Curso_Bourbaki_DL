


import numpy as np
import tensorflow as tf
from tensorflow.keras import layers, models

from sklearn.metrics import classification_report, confusion_matrix

import matplotlib.pyplot as plt








(x_train, y_train), (x_test, y_test) = tf.keras.datasets.fashion_mnist.load_data()
x_train = x_train / 255.0
x_test = x_test / 255.0













def build_baseline():
    model = models.Sequential([
        layers.Conv2D(32, (3,3), input_shape=(28,28,1), padding='same'),
        layers.BatchNormalization(),
        layers.ReLU(),
        layers.MaxPooling2D(),
        
        layers.Flatten(),
        layers.Dense(256, activation='relu'),
        layers.Dense(128, activation='relu'),
        layers.Dense(10, activation='softmax')
    ])
    model.compile(optimizer='adam', loss='sparse_categorical_crossentropy',
                  metrics=['accuracy'])
    return model

baseline = build_baseline()
history_base = baseline.fit(x_train, y_train, epochs=20, validation_split=0.2)







l2 = tf.keras.regularizers.l2(0.0001)

def build_l2():
    model = models.Sequential([
        layers.Conv2D(32, (3,3), input_shape=(28,28,1), padding='same', kernel_regularizer=l2),
        layers.BatchNormalization(),
        layers.ReLU(),
        layers.MaxPooling2D(),
        
        layers.Flatten(),
        layers.Dense(256, activation='relu', kernel_regularizer=l2),
        layers.Dense(128, activation='relu', kernel_regularizer=l2),
        layers.Dense(10, activation='softmax')
    ])
    model.compile(optimizer='adam', loss='sparse_categorical_crossentropy',
                  metrics=['accuracy'])
    return model

model_l2 = build_l2()
history_l2 = model_l2.fit(x_train, y_train, epochs=20, validation_split=0.2)






plt.plot(history_base.history['val_accuracy'], label='Baseline')
plt.plot(history_l2.history['val_accuracy'], label='L2')
plt.legend()
plt.show()



y_pred1 = baseline.predict(x_test)
y_pred1 = np.argmax(y_pred1, axis=1)
y_pred1


y_pred2 = model_l2.predict(x_test)
y_pred2 = np.argmax(y_pred2, axis=1)
y_pred2


print(classification_report(y_test, y_pred1))


print(classification_report(y_test, y_pred2))



